<div class="card">
  <div class="card-header">
    <div class="d-flex justify-content-between align-items-center w-100">
      <h3 style="margin: 0;"><i class="fa-solid fa-file-export text-muted"></i> Chi tiết Phiếu Xuất Kho</h3>
      <a href="/export" class="btn btn-outline">
        <i class="fa-solid fa-arrow-left"></i> Quay lại
      </a>
    </div>
  </div>
  
  <div class="row" style="display: flex; gap: 30px; margin-bottom: 30px;">
    <div style="flex: 1; padding: 20px; background: var(--bg-secondary); border-radius: var(--radius-md);">
      <h4 class="mb-3" style="color: var(--accent-primary);">Thông tin chung</h4>
      <table style="width: 100%; border-spacing: 0 10px;">
        <tr>
          <td style="color: var(--text-muted); width: 120px;">Mã phiếu:</td>
          <td style="font-weight: bold;">{{receipt.receiptCode}}</td>
        </tr>
        <tr>
          <td style="color: var(--text-muted);">Ngày lập:</td>
          <td>{{formatDateTime receipt.exportDate}}</td>
        </tr>
        <tr>
          <td style="color: var(--text-muted);">Người lập:</td>
          <td>{{receipt.user.fullName}}</td>
        </tr>
        <tr>
          <td style="color: var(--text-muted);">Lý do:</td>
          <td>{{{reasonBadge receipt.reason}}}</td>
        </tr>
        <tr>
          <td style="color: var(--text-muted);">Ghi chú:</td>
          <td>{{receipt.note}}</td>
        </tr>
      </table>
    </div>
    
    <div style="flex: 1; padding: 20px; background: var(--bg-secondary); border-radius: var(--radius-md);">
      <h4 class="mb-3" style="color: var(--accent-primary);">Thông tin Khách Hàng</h4>
      <table style="width: 100%; border-spacing: 0 10px;">
        <tr>
          <td style="color: var(--text-muted); width: 120px;">Tên KH:</td>
          <td style="font-weight: bold;">{{receipt.customer.name}}</td>
        </tr>
        <tr>
          <td style="color: var(--text-muted);">Số điện thoại:</td>
          <td>{{receipt.customer.phone}}</td>
        </tr>
        <tr>
          <td style="color: var(--text-muted);">Loại khách:</td>
          <td>{{{customerTypeBadge receipt.customer.type}}}</td>
        </tr>
      </table>
    </div>
  </div>
  
  <h4 class="mb-3">Danh sách sản phẩm xuất</h4>
  <div class="table-responsive">
    <table class="table">
      <thead>
        <tr>
          <th>STT</th>
          <th>Sản phẩm</th>
          <th>Lấy từ vị trí</th>
          <th>Số lượng</th>
          <th>Giá bán</th>
          <th>Thành tiền</th>
          {{#isManagerOrAdmin user.role}}
          <th>Lợi nhuận (FIFO)</th>
          {{/isManagerOrAdmin}}
        </tr>
      </thead>
      <tbody>
        {{#each receipt.items}}
        <tr>
          <td>{{inc @index}}</td>
          <td>
            <div style="font-weight: 500;">[{{this.product.sku}}] {{this.product.name}}</div>
          </td>
          <td>
            <div style="font-size: 0.9rem;" class="text-muted">
              Khu {{this.shelf.lot.zone.code}} > Lô {{this.shelf.lot.code}} > Kệ {{this.shelf.code}}
            </div>
          </td>
          <td><b>{{this.quantity}}</b></td>
          <td>{{formatCurrency this.exportPrice}}</td>
          <td style="font-weight: 600; color: var(--info);">{{formatCurrency this.subTotal}}</td>
          
          {{#isManagerOrAdmin ../user.role}}
          <td style="color: var(--success); font-weight: 600;">{{formatCurrency this.profit}}</td>
          {{/isManagerOrAdmin}}
        </tr>
        {{#isManagerOrAdmin ../user.role}}
        <tr style="background-color: rgba(0,0,0,0.1);">
          <td></td>
          <td colspan="6">
            <div style="font-size: 0.8rem; color: var(--text-muted); padding: 5px 10px;">
              <i>Chi tiết trừ kho (FIFO):</i>
              {{#each this.batchDeductions}}
              <span style="display: inline-block; margin-right: 15px; background: rgba(255,255,255,0.05); padding: 2px 6px; border-radius: 4px;">
                Trừ {{this.quantity}} SP (Giá nhập: {{formatCurrency this.importPrice}})
              </span>
              {{/each}}
            </div>
          </td>
        </tr>
        {{/isManagerOrAdmin}}
        {{/each}}
      </tbody>
      <tfoot>
        <tr>
          <th colspan="5" class="text-right" style="font-size: 1.2rem;">Tổng cộng:</th>
          <th style="font-size: 1.2rem; color: var(--info);">{{formatCurrency receipt.totalAmount}}</th>
          {{#isManagerOrAdmin user.role}}
          <th style="font-size: 1.2rem; color: var(--success);">{{formatCurrency receipt.totalProfit}}</th>
          {{/isManagerOrAdmin}}
        </tr>
      </tfoot>
    </table>
  </div>
  
  <div class="text-center mt-4">
    <button class="btn btn-outline" onclick="window.print()">
      <i class="fa-solid fa-print"></i> In Phiếu Xuất
    </button>
  </div>
</div>

<style>
  @media print {
    .sidebar, .topbar, .btn { display: none !important; }
    .main-content { margin: 0 !important; }
    .card { border: none !important; box-shadow: none !important; }
    body { background: white !important; color: black !important; }
    .table td, .table th { color: black !important; border-color: #ddd !important; }
  }
</style>
