<div class="auth-card">
  <div class="auth-logo">
    <h1>👔 WareHouse</h1>
    <p>Tạo tài khoản mới</p>
  </div>

  {{#if error_msg}}
  <div class="alert alert-danger">❌ {{error_msg}}</div>
  {{/if}}

  <form action="/register" method="POST">
    <div class="form-group">
      <label for="fullName">Họ và tên</label>
      <input type="text" id="fullName" name="fullName" class="form-control" placeholder="Nhập họ tên" required>
    </div>
    <div class="form-group">
      <label for="username">Tên đăng nhập</label>
      <input type="text" id="username" name="username" class="form-control" placeholder="Tối thiểu 3 ký tự" required>
    </div>
    <div class="form-group">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" class="form-control" placeholder="example@email.com" required>
    </div>
    <div class="form-group">
      <label for="password">Mật khẩu</label>
      <input type="password" id="password" name="password" class="form-control" placeholder="Tối thiểu 6 ký tự" required>
    </div>
    <button type="submit" class="btn btn-primary btn-lg">Đăng ký</button>
  </form>

  <div class="auth-footer">
    Đã có tài khoản? <a href="/login">Đăng nhập</a>
  </div>
</div>
