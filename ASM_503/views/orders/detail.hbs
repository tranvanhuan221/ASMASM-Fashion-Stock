<div class="page-header"><h2>📋 {{order.orderCode}}</h2><a href="/orders" class="btn btn-outline">← Quay lại</a></div>

<div class="card mb-3">
  <div class="form-row">
    <div><div class="detail-row"><span class="detail-label">Mã đơn hàng</span><span class="detail-value"><strong>{{order.orderCode}}</strong></span></div>
    <div class="detail-row"><span class="detail-label">Khách hàng</span><span class="detail-value">{{order.customer.name}}</span></div>
    <div class="detail-row"><span class="detail-label">Ngày đặt</span><span class="detail-value">{{formatDateTime order.orderDate}}</span></div></div>
    <div><div class="detail-row"><span class="detail-label">Trạng thái</span><span class="detail-value">{{{statusBadge order.status}}}</span></div>
    <div class="detail-row"><span class="detail-label">Tổng tiền</span><span class="detail-value"><strong style="color:var(--accent);font-size:1.2rem;">{{formatCurrency order.totalAmount}}</strong></span></div>
    <div class="detail-row"><span class="detail-label">Giảm giá</span><span class="detail-value">{{formatCurrency order.discount}}</span></div>
    <div class="detail-row"><span class="detail-label">Người tạo</span><span class="detail-value">{{order.user.fullName}}</span></div></div>
  </div>
  {{#if order.note}}<div class="mt-2"><strong>Ghi chú:</strong> {{order.note}}</div>{{/if}}

  <!-- Status Actions -->
  <div class="form-actions">
    {{#ifCond order.status '==' 'pending'}}
    <form action="/orders/{{order.id}}/status" method="POST" style="display:inline"><input type="hidden" name="status" value="confirmed"><button type="submit" class="btn btn-success btn-sm" onclick="return confirm('Xác nhận đơn hàng? Tồn kho sẽ bị trừ.')">✅ Xác nhận</button></form>
    <form action="/orders/{{order.id}}/status" method="POST" style="display:inline"><input type="hidden" name="status" value="cancelled"><button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Hủy đơn hàng?')">❌ Hủy đơn</button></form>
    {{/ifCond}}
    {{#ifCond order.status '==' 'confirmed'}}
    <form action="/orders/{{order.id}}/status" method="POST" style="display:inline"><input type="hidden" name="status" value="shipping"><button type="submit" class="btn btn-info btn-sm">🚚 Giao hàng</button></form>
    <form action="/orders/{{order.id}}/status" method="POST" style="display:inline"><input type="hidden" name="status" value="cancelled"><button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Hủy đơn? Tồn kho sẽ được hoàn lại.')">❌ Hủy</button></form>
    {{/ifCond}}
    {{#ifCond order.status '==' 'shipping'}}
    <form action="/orders/{{order.id}}/status" method="POST" style="display:inline"><input type="hidden" name="status" value="completed"><button type="submit" class="btn btn-success btn-sm">✅ Hoàn thành</button></form>
    {{/ifCond}}
  </div>
</div>

<div class="table-container">
  <div class="table-header"><h3>📦 Chi tiết đơn hàng</h3></div>
  <table><thead><tr><th>Sản phẩm</th><th>SKU</th><th>Số lượng</th><th>Đơn giá</th><th>Thành tiền</th></tr></thead>
  <tbody>
    {{#each order.details}}<tr>
      <td>{{this.product.name}}</td>
      <td>{{this.product.sku}}</td>
      <td>{{this.quantity}}</td>
      <td>{{formatCurrency this.unitPrice}}</td>
      <td><strong>{{formatCurrency this.subtotal}}</strong></td>
    </tr>{{/each}}
  </tbody></table>
</div>
