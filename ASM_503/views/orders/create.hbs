<div class="page-header"><h2>+ Tạo đơn hàng mới</h2><a href="/orders" class="btn btn-outline">← Quay lại</a></div>
<div class="card">
  <form action="/orders" method="POST" id="orderForm">
    <div class="form-row">
      <div class="form-group"><label for="customerId">Khách hàng *</label>
        <select id="customerId" name="customerId" class="form-control" required>
          <option value="">-- Chọn khách hàng --</option>
          {{#each customers}}<option value="{{this.id}}">{{this.name}} {{#if this.phone}}({{this.phone}}){{/if}}</option>{{/each}}
        </select>
      </div>
      <div class="form-group"><label for="discount">Giảm giá (₫)</label><input type="number" id="discount" name="discount" class="form-control" min="0" step="1000" value="0"></div>
    </div>

    <h3 class="mb-2">Sản phẩm đặt hàng</h3>
    <div id="orderItems">
      <div class="order-items-form">
        <div class="item-row" data-index="0">
          <div class="form-group"><label>Sản phẩm</label>
            <select name="productId" class="form-control product-select" required>
              <option value="">-- Chọn --</option>
              {{#each products}}<option value="{{this.id}}" data-price="{{this.exportPrice}}" data-qty="{{this.quantity}}">{{this.sku}} - {{this.name}} (Tồn: {{this.quantity}})</option>{{/each}}
            </select>
          </div>
          <div class="form-group"><label>Số lượng</label><input type="number" name="quantity" class="form-control item-qty" min="1" value="1" required></div>
          <div class="form-group"><label>Đơn giá</label><input type="number" name="unitPrice" class="form-control item-price" min="0" step="1000" value="0" required></div>
          <div class="form-group"><label>Thành tiền</label><input type="text" class="form-control item-subtotal" readonly value="0 ₫"></div>
          <div class="form-group" style="padding-top:24px;"><button type="button" class="btn btn-danger btn-sm remove-item" onclick="removeItem(this)">✕</button></div>
        </div>
      </div>
    </div>
    <button type="button" class="btn btn-outline btn-sm mt-2" onclick="addItem()">+ Thêm sản phẩm</button>

    <div style="margin-top:20px;padding:16px;background:var(--bg-tertiary);border-radius:var(--radius-sm);text-align:right;">
      <span class="text-secondary">Tổng cộng: </span>
      <strong id="orderTotal" style="font-size:1.3rem;color:var(--accent);">0 ₫</strong>
    </div>

    <div class="form-group mt-2"><label for="note">Ghi chú</label><textarea id="note" name="note" class="form-control" rows="2"></textarea></div>
    <div class="form-actions"><button type="submit" class="btn btn-primary">🛒 Tạo đơn hàng</button><a href="/orders" class="btn btn-outline">Hủy</a></div>
  </form>
</div>

<script>
const productsData = [{{#each products}}{id:{{this.id}},sku:'{{this.sku}}',name:'{{this.name}}',price:{{this.exportPrice}},qty:{{this.quantity}}},{{/each}}];

function addItem() {
  const container = document.querySelector('.order-items-form');
  const idx = container.children.length;
  const opts = productsData.map(p => `<option value="${p.id}" data-price="${p.price}" data-qty="${p.qty}">${p.sku} - ${p.name} (Tồn: ${p.qty})</option>`).join('');
  const html = `<div class="item-row" data-index="${idx}"><div class="form-group"><label>Sản phẩm</label><select name="productId" class="form-control product-select" required><option value="">-- Chọn --</option>${opts}</select></div><div class="form-group"><label>Số lượng</label><input type="number" name="quantity" class="form-control item-qty" min="1" value="1" required></div><div class="form-group"><label>Đơn giá</label><input type="number" name="unitPrice" class="form-control item-price" min="0" step="1000" value="0" required></div><div class="form-group"><label>Thành tiền</label><input type="text" class="form-control item-subtotal" readonly value="0 ₫"></div><div class="form-group" style="padding-top:24px;"><button type="button" class="btn btn-danger btn-sm remove-item" onclick="removeItem(this)">✕</button></div></div>`;
  container.insertAdjacentHTML('beforeend', html);
  bindItemEvents();
}

function removeItem(btn) {
  if (document.querySelectorAll('.item-row').length > 1) {
    btn.closest('.item-row').remove();
    calcTotal();
  }
}

function bindItemEvents() {
  document.querySelectorAll('.product-select').forEach(sel => {
    sel.onchange = function() {
      const opt = this.options[this.selectedIndex];
      const row = this.closest('.item-row');
      if (opt.dataset.price) row.querySelector('.item-price').value = opt.dataset.price;
      calcRow(row); calcTotal();
    };
  });
  document.querySelectorAll('.item-qty, .item-price').forEach(inp => {
    inp.oninput = function() { calcRow(this.closest('.item-row')); calcTotal(); };
  });
}

function calcRow(row) {
  const qty = parseFloat(row.querySelector('.item-qty').value) || 0;
  const price = parseFloat(row.querySelector('.item-price').value) || 0;
  row.querySelector('.item-subtotal').value = (qty * price).toLocaleString('vi-VN') + ' ₫';
}

function calcTotal() {
  let total = 0;
  document.querySelectorAll('.item-row').forEach(row => {
    const qty = parseFloat(row.querySelector('.item-qty').value) || 0;
    const price = parseFloat(row.querySelector('.item-price').value) || 0;
    total += qty * price;
  });
  const discount = parseFloat(document.getElementById('discount').value) || 0;
  document.getElementById('orderTotal').textContent = (total - discount).toLocaleString('vi-VN') + ' ₫';
}

document.getElementById('discount')?.addEventListener('input', calcTotal);
bindItemEvents();
</script>
