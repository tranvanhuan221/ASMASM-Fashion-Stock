<div class="page-header">
  <h2>✏️ Sửa sản phẩm</h2>
  <a href="/products" class="btn btn-outline">← Quay lại</a>
</div>

<div class="card">
  <form action="/products/{{product.id}}" method="POST" enctype="multipart/form-data">
    <div class="form-row">
      <div class="form-group">
        <label for="name">Tên sản phẩm *</label>
        <input type="text" id="name" name="name" class="form-control" required value="{{product.name}}">
      </div>
      <div class="form-group">
        <label for="sku">Mã SKU *</label>
        <input type="text" id="sku" name="sku" class="form-control" required value="{{product.sku}}">
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="categoryId">Danh mục</label>
        <select id="categoryId" name="categoryId" class="form-control">
          <option value="">-- Chọn danh mục --</option>
          {{#each categories}}
          <option value="{{this.id}}" {{selected ../product.categoryId this.id}}>{{this.name}}</option>
          {{/each}}
        </select>
      </div>
      <div class="form-group">
        <label for="supplierId">Nhà cung cấp</label>
        <select id="supplierId" name="supplierId" class="form-control">
          <option value="">-- Chọn NCC --</option>
          {{#each suppliers}}
          <option value="{{this.id}}" {{selected ../product.supplierId this.id}}>{{this.name}}</option>
          {{/each}}
        </select>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="size">Size</label>
        <select id="size" name="size" class="form-control">
          <option value="">-- Chọn --</option>
          <option value="XS" {{selected product.size "XS"}}>XS</option>
          <option value="S" {{selected product.size "S"}}>S</option>
          <option value="M" {{selected product.size "M"}}>M</option>
          <option value="L" {{selected product.size "L"}}>L</option>
          <option value="XL" {{selected product.size "XL"}}>XL</option>
          <option value="XXL" {{selected product.size "XXL"}}>XXL</option>
          <option value="Free Size" {{selected product.size "Free Size"}}>Free Size</option>
        </select>
      </div>
      <div class="form-group">
        <label for="color">Màu sắc</label>
        <input type="text" id="color" name="color" class="form-control" value="{{product.color}}">
      </div>
      <div class="form-group">
        <label for="material">Chất liệu</label>
        <input type="text" id="material" name="material" class="form-control" value="{{product.material}}">
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="importPrice">Giá nhập (₫)</label>
        <input type="number" id="importPrice" name="importPrice" class="form-control" step="1000" value="{{product.importPrice}}">
      </div>
      <div class="form-group">
        <label for="exportPrice">Giá bán (₫)</label>
        <input type="number" id="exportPrice" name="exportPrice" class="form-control" step="1000" value="{{product.exportPrice}}">
      </div>
      <div class="form-group">
        <label for="minQuantity">Tồn kho tối thiểu</label>
        <input type="number" id="minQuantity" name="minQuantity" class="form-control" value="{{product.minQuantity}}">
      </div>
    </div>

    <div class="form-group">
      <label for="description">Mô tả</label>
      <textarea id="description" name="description" class="form-control" rows="3">{{product.description}}</textarea>
    </div>

    <div class="form-group">
      <label for="image">Ảnh sản phẩm</label>
      {{#if product.image}}
      <div class="mb-1"><img src="{{product.image}}" alt="{{product.name}}" style="max-width:150px;border-radius:8px;"></div>
      {{/if}}
      <input type="file" id="image" name="image" class="form-control" accept="image/*" onchange="previewImage(this)">
      <img id="imagePreview" src="" alt="" style="display:none;max-width:200px;margin-top:12px;border-radius:8px;">
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">💾 Cập nhật</button>
      <a href="/products" class="btn btn-outline">Hủy</a>
    </div>
  </form>
</div>
