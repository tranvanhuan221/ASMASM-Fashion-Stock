<div class="card mb-4">
  <div class="card-header">
    <h3><i class="fa-solid fa-plus-circle text-muted"></i> Tạo Phiếu Nhập Kho Mới</h3>
  </div>
  
  <div class="row" style="display: flex; gap: 30px;">
    <!-- Thông tin chung -->
    <div style="flex: 1;">
      <h4 class="mb-4" style="color: var(--accent-primary); border-bottom: 1px solid var(--border-color); padding-bottom: 10px;">Thông tin chung</h4>
      
      <div class="form-group">
        <label class="form-label">Mã phiếu</label>
        <input type="text" class="form-control" id="receiptCode" value="{{receiptCode}}" readonly>
      </div>
      
      <div class="form-group">
        <label class="form-label">Nhà cung cấp</label>
        <select class="form-control form-select" id="supplierId" required>
          <option value="">-- Chọn nhà cung cấp --</option>
          {{#each suppliers}}
          <option value="{{this._id}}">{{this.name}}</option>
          {{/each}}
        </select>
      </div>
      
      <div class="form-group">
        <label class="form-label">Loại nhập</label>
        <select class="form-control form-select" id="type" required>
          <option value="individual">Nhập lẻ (Từng sản phẩm riêng lẻ)</option>
          <option value="batch">Nhập lô (Số lượng lớn cùng loại)</option>
        </select>
      </div>
      
      <div class="form-group">
        <label class="form-label">Ghi chú</label>
        <textarea class="form-control" id="note" rows="3"></textarea>
      </div>
    </div>
    
    <!-- Thêm sản phẩm -->
    <div style="flex: 2; border-left: 1px solid var(--border-color); padding-left: 30px;">
      <h4 class="mb-4" style="color: var(--accent-primary); border-bottom: 1px solid var(--border-color); padding-bottom: 10px;">Chi tiết hàng nhập</h4>
      
      <!-- Form add item -->
      <div class="glass" style="padding: 20px; border-radius: var(--radius-md); margin-bottom: 20px;">
        <div style="display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 15px; margin-bottom: 15px;">
          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label">Sản phẩm</label>
            <select class="form-control form-select" id="tempProduct">
              <option value="">-- Chọn sản phẩm --</option>
              {{#each products}}
              <option value="{{this._id}}" data-name="{{this.name}}">[{{this.sku}}] {{this.name}}</option>
              {{/each}}
            </select>
          </div>
          
          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label">Số lượng</label>
            <input type="number" class="form-control" id="tempQty" min="1" value="1">
          </div>
          
          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label">Giá nhập</label>
            <input type="number" class="form-control" id="tempPrice" min="0" placeholder="VNĐ">
          </div>
        </div>
        
        <div class="form-group">
          <label class="form-label">Vị trí lưu kho (Khu vực / Lô / Kệ)</label>
          <select class="form-control form-select" id="tempShelf">
            <option value="">-- Chọn vị trí lưu kho --</option>
            {{#each zones}}
              <optgroup label="Khu: {{this.name}}">
                {{#each this.lots}}
                  {{#each this.shelves}}
                  <option value="{{this._id}}" data-path="Khu {{../../name}} > Lô {{../code}} > Kệ {{this.code}}">
                    Lô {{../code}} - Kệ {{this.code}} ({{this.name}})
                  </option>
                  {{/each}}
                {{/each}}
              </optgroup>
            {{/each}}
          </select>
        </div>
        
        <button type="button" class="btn btn-outline" style="width: 100%; border-color: var(--accent-primary); color: var(--accent-primary);" onclick="addItem()">
          <i class="fa-solid fa-plus"></i> Thêm vào danh sách
        </button>
      </div>
      
      <!-- Items table -->
      <div class="table-responsive">
        <table class="table" id="itemsTable">
          <thead>
            <tr>
              <th>Sản phẩm</th>
              <th>Vị trí</th>
              <th>SL</th>
              <th>Giá nhập</th>
              <th>Thành tiền</th>
              <th>Xóa</th>
            </tr>
          </thead>
          <tbody id="itemsBody">
            <tr id="emptyRow">
              <td colspan="6" class="text-center text-muted">Chưa có sản phẩm nào</td>
            </tr>
          </tbody>
          <tfoot>
            <tr>
              <th colspan="4" class="text-right">Tổng cộng:</th>
              <th colspan="2" id="totalAmountDisplay" style="color: var(--success); font-size: 1.2rem;">0 ₫</th>
            </tr>
          </tfoot>
        </table>
      </div>
      
      <div class="text-right mt-4">
        <a href="/inventory" class="btn btn-outline mr-2">Hủy</a>
        <button class="btn btn-primary" id="btnSubmit" onclick="submitReceipt()" disabled>
          <i class="fa-solid fa-save"></i> Lưu Phiếu Nhập
        </button>
      </div>
    </div>
  </div>
</div>

{{#section 'script'}}
<script>
  let receiptItems = [];
  
  function formatCurrency(amount) {
    return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(amount);
  }
  
  function addItem() {
    const productSelect = document.getElementById('tempProduct');
    const shelfSelect = document.getElementById('tempShelf');
    const qtyInput = document.getElementById('tempQty');
    const priceInput = document.getElementById('tempPrice');
    
    if (!productSelect.value || !shelfSelect.value || !qtyInput.value || !priceInput.value) {
      alert('Vui lòng nhập đầy đủ thông tin sản phẩm');
      return;
    }
    
    const productId = productSelect.value;
    const productName = productSelect.options[productSelect.selectedIndex].getAttribute('data-name');
    const skuText = productSelect.options[productSelect.selectedIndex].text.split(']')[0] + ']';
    
    const shelfId = shelfSelect.value;
    const shelfPath = shelfSelect.options[shelfSelect.selectedIndex].getAttribute('data-path');
    
    const quantity = parseInt(qtyInput.value);
    const importPrice = parseFloat(priceInput.value);
    const subTotal = quantity * importPrice;
    
    receiptItems.push({
      productId,
      productName: `${skuText} ${productName}`,
      shelfId,
      shelfPath,
      quantity,
      importPrice,
      subTotal
    });
    
    // Clear inputs
    productSelect.value = '';
    shelfSelect.value = '';
    qtyInput.value = '1';
    priceInput.value = '';
    
    renderItems();
  }
  
  function removeItem(index) {
    receiptItems.splice(index, 1);
    renderItems();
  }
  
  function renderItems() {
    const tbody = document.getElementById('itemsBody');
    const btnSubmit = document.getElementById('btnSubmit');
    
    if (receiptItems.length === 0) {
      tbody.innerHTML = '<tr id="emptyRow"><td colspan="6" class="text-center text-muted">Chưa có sản phẩm nào</td></tr>';
      document.getElementById('totalAmountDisplay').innerText = '0 ₫';
      btnSubmit.disabled = true;
      return;
    }
    
    btnSubmit.disabled = false;
    let html = '';
    let total = 0;
    
    receiptItems.forEach((item, index) => {
      total += item.subTotal;
      html += `
        <tr>
          <td><div style="font-weight: 500;">${item.productName}</div></td>
          <td><div style="font-size: 0.85rem;" class="text-muted">${item.shelfPath}</div></td>
          <td><b>${item.quantity}</b></td>
          <td>${formatCurrency(item.importPrice)}</td>
          <td style="color: var(--success); font-weight: 600;">${formatCurrency(item.subTotal)}</td>
          <td>
            <button class="btn btn-danger" style="padding: 4px 8px;" onclick="removeItem(${index})">
              <i class="fa-solid fa-trash"></i>
            </button>
          </td>
        </tr>
      `;
    });
    
    tbody.innerHTML = html;
    document.getElementById('totalAmountDisplay').innerText = formatCurrency(total);
  }
  
  async function submitReceipt() {
    const supplierId = document.getElementById('supplierId').value;
    if (!supplierId) {
      alert('Vui lòng chọn nhà cung cấp');
      return;
    }
    
    if (receiptItems.length === 0) {
      alert('Vui lòng thêm ít nhất 1 sản phẩm');
      return;
    }
    
    const data = {
      receiptCode: document.getElementById('receiptCode').value,
      supplierId,
      type: document.getElementById('type').value,
      note: document.getElementById('note').value,
      items: receiptItems
    };
    
    try {
      document.getElementById('btnSubmit').disabled = true;
      document.getElementById('btnSubmit').innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Đang xử lý...';
      
      const res = await fetch('/api/v1/inventory/receipts', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      
      const result = await res.json();
      if(result.success) {
        window.location.href = '/inventory';
      } else {
        alert(result.message);
        document.getElementById('btnSubmit').disabled = false;
        document.getElementById('btnSubmit').innerHTML = '<i class="fa-solid fa-save"></i> Lưu Phiếu Nhập';
      }
    } catch(err) {
      alert('Có lỗi xảy ra');
      document.getElementById('btnSubmit').disabled = false;
      document.getElementById('btnSubmit').innerHTML = '<i class="fa-solid fa-save"></i> Lưu Phiếu Nhập';
    }
  }
</script>
{{/section}}
