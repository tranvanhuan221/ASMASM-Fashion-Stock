<div class="card">
  <div class="card-header">
    <div class="d-flex justify-content-between align-items-center w-100">
      <h3 style="margin: 0;"><i class="fa-solid fa-file-invoice text-muted"></i> Chi tiết Phiếu Nhập Kho</h3>
      <a href="/inventory" class="btn btn-outline">
        <i class="fa-solid fa-arrow-left"></i> Quay lại
      </a>
    </div>
  </div>
  
  <div class="row" style="display: flex; gap: 30px; margin-bottom: 30px;">
    <div style="flex: 1; padding: 20px; background: var(--bg-secondary); border-radius: var(--radius-md);">
      <h4 class="mb-3" style="color: var(--accent-primary);">Thông tin chung</h4>
      <table style="width: 100%; border-spacing: 0 10px;">
        <tr>
          <td style="color: var(--text-muted); width: 120px;">Mã phiếu:</td>
          <td style="font-weight: bold;">{{receipt.receiptCode}}</td>
        </tr>
        <tr>
          <td style="color: var(--text-muted);">Ngày lập:</td>
          <td>{{formatDateTime receipt.importDate}}</td>
        </tr>
        <tr>
          <td style="color: var(--text-muted);">Người lập:</td>
          <td>{{receipt.user.fullName}}</td>
        </tr>
        <tr>
          <td style="color: var(--text-muted);">Loại nhập:</td>
          <td>{{{importTypeBadge receipt.type}}}</td>
        </tr>
        <tr>
          <td style="color: var(--text-muted);">Ghi chú:</td>
          <td>{{receipt.note}}</td>
        </tr>
      </table>
    </div>
    
    <div style="flex: 1; padding: 20px; background: var(--bg-secondary); border-radius: var(--radius-md);">
      <h4 class="mb-3" style="color: var(--accent-primary);">Thông tin Nhà Cung Cấp</h4>
      <table style="width: 100%; border-spacing: 0 10px;">
        <tr>
          <td style="color: var(--text-muted); width: 120px;">Tên NCC:</td>
          <td style="font-weight: bold;">{{receipt.supplier.name}}</td>
        </tr>
        <tr>
          <td style="color: var(--text-muted);">Số điện thoại:</td>
          <td>{{receipt.supplier.phone}}</td>
        </tr>
        <tr>
          <td style="color: var(--text-muted);">Email:</td>
          <td>{{receipt.supplier.email}}</td>
        </tr>
        <tr>
          <td style="color: var(--text-muted);">Địa chỉ:</td>
          <td>{{receipt.supplier.address}}</td>
        </tr>
      </table>
    </div>
  </div>
  
  <h4 class="mb-3">Danh sách sản phẩm nhập</h4>
  <div class="table-responsive">
    <table class="table">
      <thead>
        <tr>
          <th>STT</th>
          <th>Sản phẩm</th>
          <th>Vị trí lưu kho</th>
          <th>Số lượng</th>
          <th>Đơn giá</th>
          <th>Thành tiền</th>
        </tr>
      </thead>
      <tbody>
        {{#each receipt.items}}
        <tr>
          <td>{{inc @index}}</td>
          <td>
            <div style="font-weight: 500;">[{{this.product.sku}}] {{this.product.name}}</div>
          </td>
          <td>
            <div style="font-size: 0.9rem;" class="text-muted">
              Khu {{this.shelf.lot.zone.code}} > Lô {{this.shelf.lot.code}} > Kệ {{this.shelf.code}}
            </div>
          </td>
          <td><b>{{this.quantity}}</b></td>
          <td>{{formatCurrency this.importPrice}}</td>
          <td style="font-weight: 600; color: var(--success);">{{formatCurrency this.subTotal}}</td>
        </tr>
        {{/each}}
      </tbody>
      <tfoot>
        <tr>
          <th colspan="5" class="text-right" style="font-size: 1.2rem;">Tổng tiền hàng:</th>
          <th style="font-size: 1.2rem; color: var(--success);">{{formatCurrency receipt.totalAmount}}</th>
        </tr>
      </tfoot>
    </table>
  </div>
  
  <div class="text-center mt-4">
    <button class="btn btn-outline" onclick="window.print()">
      <i class="fa-solid fa-print"></i> In Phiếu Nhập
    </button>
  </div>
</div>

<style>
  @media print {
    .sidebar, .topbar, .btn { display: none !important; }
    .main-content { margin: 0 !important; }
    .card { border: none !important; box-shadow: none !important; }
    body { background: white !important; color: black !important; }
    .table td, .table th { color: black !important; border-color: #ddd !important; }
  }
</style>
