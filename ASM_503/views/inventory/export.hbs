<div class="page-header"><h2>📤 Xuất Kho</h2><a href="/inventory" class="btn btn-outline">← Quay lại</a></div>
<div class="card">
  <form action="/inventory/export" method="POST">
    <div class="form-row">
      <div class="form-group"><label for="productId">Sản phẩm *</label>
        <select id="productId" name="productId" class="form-control" required>
          <option value="">-- Chọn sản phẩm --</option>
          {{#each products}}<option value="{{this.id}}" data-qty="{{this.quantity}}">{{this.sku}} - {{this.name}} (Tồn: {{this.quantity}})</option>{{/each}}
        </select>
      </div>
      <div class="form-group"><label>Tồn kho hiện tại</label><input type="text" id="currentStock" class="form-control" readonly value="Chọn sản phẩm..."></div>
    </div>
    <div class="form-row">
      <div class="form-group"><label for="quantity">Số lượng xuất *</label><input type="number" id="quantity" name="quantity" class="form-control" required min="1" value="1"></div>
      <div class="form-group"><label for="unitPrice">Đơn giá xuất (₫) *</label><input type="number" id="unitPrice" name="unitPrice" class="form-control" required min="0" step="1000" value="0"></div>
    </div>
    <div class="form-group"><label for="note">Ghi chú</label><textarea id="note" name="note" class="form-control" rows="2"></textarea></div>
    <div class="form-actions"><button type="submit" class="btn btn-warning">📤 Xác nhận xuất kho</button><a href="/inventory" class="btn btn-outline">Hủy</a></div>
  </form>
</div>
<script>
document.getElementById('productId')?.addEventListener('change', function() {
  const opt = this.options[this.selectedIndex];
  document.getElementById('currentStock').value = opt.dataset.qty ? `Còn: ${opt.dataset.qty} sản phẩm` : 'Chọn sản phẩm...';
});
</script>
